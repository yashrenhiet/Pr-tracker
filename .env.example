# Copy to .env and fill in. docker compose and the backend both read these.

# --- PostgreSQL ---
POSTGRES_DB=prtracker
POSTGRES_USER=prtracker
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Backend ---
# Port 8081 by default (8080 is commonly taken by other local tools).
SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/prtracker
DB_USERNAME=prtracker
DB_PASSWORD=change-me
