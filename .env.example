# Copy to .env and fill in. docker compose and the backend both read these.

# --- PostgreSQL ---
POSTGRES_DB=prtracker
POSTGRES_USER=prtracker
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Backend ---
# Port 8081 by default (8080 is commonly taken by other local tools).
SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/prtracker
DB_USERNAME=prtracker
DB_PASSWORD=change-me

# --- Frontend BFF (server:start / server:dev in frontend/) ---
PORT=3000
BACKEND_URL=http://localhost:8081

# --- AI code review (optional; disabled by default) ---
# Uncomment and fill in to turn on the AI review engine. See README.md "AI code review" for details.
# AI_REVIEW_ENABLED=true
# AI_REVIEW_PROVIDER=openai            # openai | anthropic
# AI_REVIEW_API_KEY=sk-...
# AI_REVIEW_MODEL=                     # blank = provider's current default
# AI_REVIEW_GITHUB_TOKEN=ghp_...       # needs read access to PRs, write access to post reviews
# AI_REVIEW_DRY_RUN=true               # true = generate reviews but don't post them to GitHub
# AI_REVIEW_SCHEDULER_ENABLED=false    # true = automatically review PRs waiting on a bot review
